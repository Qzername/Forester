<Window x:Class="ForesterUpdater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ForesterUpdater"
        mc:Ignorable="d"
        Title="Forester Updater" WindowStartupLocation="CenterScreen" Height="90" Width="200" ResizeMode="NoResize">
    <Grid>
        <ProgressBar x:Name="bar" HorizontalAlignment="Center" Width="180" Margin="10,27,10,10"/>
        <Label x:Name="text" Content="Downloading 1.2V version" HorizontalAlignment="Center" VerticalAlignment="Top" HorizontalContentAlignment="Center" Width="188" Height="27"/>
    </Grid>
</Window>
