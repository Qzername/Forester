<Window x:Name="Window" x:Class="Forester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Forester"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" WindowStyle="None" Background="#FF323232" MinWidth="800" MinHeight="450">
    <Grid x:Name="Main">
        <Grid x:Name="ToolBar" Margin="0,0,0,0" MouseDown="DragBar_MouseDown" Height="18" Width="auto" VerticalAlignment="Top">
            <Rectangle Fill="Black" Height="18" VerticalAlignment="Center" Grid.ColumnSpan="2"/>

            <Button BorderBrush="Transparent" Margin="782,0,0,0" VerticalAlignment="Center" Height="18" Width="18" Click="Exit_Clicked" HorizontalAlignment="Right" MinWidth="18" MinHeight="18">
                <Button.Background>
                    <ImageBrush ImageSource="/IMG/X.png"/>
                </Button.Background>
            </Button>

            <Button BorderBrush="Transparent" Margin="764,0,0,0" VerticalAlignment="Center" Height="18" Width="18" Click="Maximize_Clicked" HorizontalAlignment="Left" MinWidth="18" MinHeight="18">
                <Button.Background>
                    <ImageBrush ImageSource="/IMG/MaxWindow.png"/>
                </Button.Background>
            </Button>

            <Button BorderBrush="Transparent" Margin="746,0,0,0" VerticalAlignment="Center" Height="18" Width="18" Click="Minimalize_Clicked" HorizontalAlignment="Left" MinWidth="18" MinHeight="18">
                <Button.Background>
                    <ImageBrush ImageSource="/IMG/MinWindow.png"/>
                </Button.Background>
            </Button>
            <Button x:Name="DeveloperButton" Content="Panel Dewelopera" HorizontalAlignment="Center" VerticalAlignment="Center" Height="18" Width="104" Click="Developer_Click"/>
        </Grid>

        <Label Content="Forester 1.0v" Width="auto" Height="auto" x:Name="Info" Foreground="White" HorizontalAlignment="Left" Margin="-2,-5,0,0" VerticalAlignment="Top"/>
        <ListBox SelectionMode="Single" x:Name="applist" Margin="10,70,0,10" Background="#FF4D4D4D" BorderBrush="#01ABADB3" SelectionChanged="applist_SelectionChanged" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="188" MinHeight="370" Height="auto"/>

        <Grid x:Name="AppInfo" MinHeight="414" Margin="203,26,5,0" MinWidth="596" RenderTransformOrigin="0.5,0.5">
            <Label Foreground="White" HorizontalContentAlignment="Center" x:Name="AppName" Content="Witamy w Foresterze!" FontSize="30" Margin="5,10,0,5" VerticalAlignment="Top"  HorizontalAlignment="Stretch"/>
            <Label Foreground="White" x:Name="AppDescription" Content="To prosty launcher i downloader dla naszych projektów.&#xA;&#xD;&#xA;Aplikacje wykonał: uZer&#xA;Specjalne podziękowania: Heapy1337 (Ikony)" FontSize="16" Margin="14,65,14,77" MinHeight="274" MinWidth="568"/>
            <Button x:Name="DownloadButton" Content="Button" Margin="0,351,0,10" VerticalAlignment="Bottom" Height="62" MinWidth="586" Click="DownloadButton_Click"/>
        </Grid>

        <Button x:Name="refreshButton" Content="Odśwież" HorizontalAlignment="Left" Margin="10,26,0,0" VerticalAlignment="Top" Height="39" Width="188" Click="refreshButton_Click" />
    </Grid>
</Window>
