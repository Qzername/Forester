<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="450"
             x:Class="Forester.Views.Popup.SettingsPages.InfoView">
	<Panel>
		<StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
			<TextBlock Foreground="{Binding third}" Text="Forester" Margin="0,20,0,0" FontSize="64"/>
		</StackPanel>
		<StackPanel Margin="0,25,0,0" Spacing="5" VerticalAlignment="Center" HorizontalAlignment="Center" >
			<TextBlock TextWrapping="WrapWithOverflow" TextAlignment="Center" Foreground="{Binding second}" Text="A project made so you can update&#xA;files faster and more plesantly" FontSize="28"/>
			<TextBlock Foreground="{Binding first}" Text="Made by uZer#1660" HorizontalAlignment="Center" FontSize="16"/>
		</StackPanel>
		<TextBlock Margin="10" Foreground="{Binding first}" Text="{Binding Path=Version, StringFormat='Version: {0}'}" FontSize="20" VerticalAlignment="Bottom"/>
		<Button Margin="10" Padding="0" Command="{Binding Discord}" Content="Discord" Background="Transparent" Foreground="{Binding first}" FontSize="20" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
	</Panel>
</UserControl>
