<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Forester.Views.Popup.SettingsView">

	<UserControl.Styles>
		<StyleInclude Source="/Views/Style/Settings.axaml" />
	</UserControl.Styles>

	<StackPanel Orientation="Horizontal">
		<Panel Width="170" Margin="10,10,0,10">
			<StackPanel Spacing="0" VerticalAlignment="Top">
				<Button Content="Info" Classes="Settings"/>
				<Button Content="User Profile" Classes="Settings"/>
				<Button Content="Theme" Classes="Settings"/>
			</StackPanel>
			<Button VerticalAlignment="Bottom" Content="Logout" Classes="Settings"/>
		</Panel>
		<Border Margin="20,15" BorderBrush="White" BorderThickness="2" CornerRadius="8"/>
	</StackPanel>
</UserControl>
