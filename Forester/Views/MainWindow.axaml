<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Forester.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Forester.Views.MainWindow"
        Icon="/Assets/forester-logo.ico"
        Title="Forester"
		DataContext="Forester.ViewModels.MainWindowViewModel"
		ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="{Binding toolBarHeight}"
		CanResize="True"
		MinWidth="1000" MinHeight="720" 
		Width="{Binding width, Mode=TwoWay}" Height="{Binding height, Mode=TwoWay}"
		WindowStartupLocation="CenterScreen">

	<Panel>
		<ContentControl Content="{Binding content}"/>
		
		<Panel Margin="{Binding popupConfig.margin}"  IsEnabled="{Binding popupIsEnabled}" IsVisible="{Binding popupIsEnabled}">
			<Border Background="#101010" Opacity="0.7"/>
			<Border Width="{Binding popupConfig.width}" Height="{Binding popupConfig.height}" Background="Black" CornerRadius="20">
				<ContentControl Content="{Binding popupConfig.content}"/>
			</Border>
		</Panel>
	</Panel>

</Window>
