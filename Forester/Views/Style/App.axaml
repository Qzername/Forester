<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="0,20">
			<Panel Background="#090909" Width="600" Height="60">
				<StackPanel Orientation="Horizontal">
					<Button Classes="Choose" Margin="10,0,0,0" Content="Sklep"/>
					<Button Classes="Choose" Margin="10,0,0,0" Content="Biblioteka"/>
					<Button Classes="Choose" Margin="10,0,0,0" Content="Znajomi"/>
				</StackPanel>
			</Panel>
        </Border>
    </Design.PreviewWith>
	<Style Selector="Button.ToolBar">
		<!-- <Button Foreground="{Binding third}" Margin="0,0,40,0" Content="-"/> -->
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="VerticalContentAlignment" Value="Center"/>
		<Setter Property="HorizontalAlignment" Value="Right"/>
		<Setter Property="HorizontalContentAlignment" Value="Center"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="Width" Value="20"/>
		<Setter Property="Height" Value="20"/>
	</Style>

	<Style Selector="Button.Choose">
		<Setter Property="FontSize" Value="28"/>
		<Setter Property="Padding" Value="5,2"/>
		<Setter Property="Background" Value="Transparent"/>
	</Style>

	<!-- Add Styles Here -->
</Styles>
