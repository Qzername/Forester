<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Forester.Views.AppView">
	
	<DockPanel>
		<!--Toolbar-->
		<StackPanel IsHitTestVisible="False" Spacing="2" DockPanel.Dock="Top" Orientation="Horizontal" Height="20">
			<Label Foreground="{Binding themeService.FirstBrush}" VerticalAlignment="Center" Padding="0" Margin="5,0,0,0" Content="Forester"/>
			<Label Foreground="{Binding themeService.Orange}" VerticalAlignment="Center" Padding="0" Content="3.0v"/>
		</StackPanel>
		
		<!--Choose panel-->
		<Panel DockPanel.Dock="Top" Background="Black" Height="60">
			<StackPanel Orientation="Horizontal">
				<Button DockPanel.Dock="Left" Content="1"/>
				<Button DockPanel.Dock="Left" Content="2"/>
				<Button DockPanel.Dock="Left" Content="3"/>
			</StackPanel>
			<Panel HorizontalAlignment="Right">
				<Button DockPanel.Dock="Right" Command="{Binding SettingsClicked}" Content="Settings"/>
			</Panel>
		</Panel>
		
		<!--Content-->
		<Panel>
			
		</Panel>
	</DockPanel>
</UserControl>
