<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Forester.Views.App.Developer.CreateAppView">
	<Panel>
		<StackPanel Width="600" VerticalAlignment="Center" HorizontalAlignment="Center">
			<Label FontSize="25" HorizontalAlignment="Center" Content="Create new app"/>
			<TextBox Text="{Binding name}" Watermark="Name" Margin="0,10,0,5" MaxLength="100"/>
			<TextBox Text="{Binding version}" Watermark="Initial Version" Margin="0,5,0,5" MaxLength="100"/>
			
			<StackPanel Orientation="Horizontal" Margin="0,5,0,0">
				<Button Width="165" Command="{Binding SelectFolder}" HorizontalContentAlignment="Center" HorizontalAlignment="Center" Content="Select folder with app" />

				<ScrollViewer Width="435" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Visible">
					<Label VerticalAlignment="Center" Content="{Binding Path=pathToFolder, StringFormat='Current path: {0}'}" Margin="5,0,0,0"/>
				</ScrollViewer>
			</StackPanel>

			<Label HorizontalAlignment="Center" Margin="5" Content="Warning: your app at start will be set as private"/>

			<Button Command="{Binding Publish}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Submit"/>
			<ProgressBar Value="{Binding percent}" Height="10" Margin="0,10,0,5"/>
			<Label FontSize="16" HorizontalAlignment="Center" Content="{Binding error}"/>
		</StackPanel>
	</Panel>
</UserControl>
