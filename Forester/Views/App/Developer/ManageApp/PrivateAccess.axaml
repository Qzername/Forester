<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Forester.Views.App.Developer.ManageApp.PrivateAccess">
	<StackPanel>
		<Label HorizontalAlignment="Center" Content="Privacy" FontSize="25"/>
		<CheckBox IsChecked="{Binding isPrivate}" HorizontalAlignment="Center" Content="Private application" Margin="5,0,0,5">
			<CheckBox.Resources>
				<SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="Gray" />
				<SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="Gray" />
				<SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="Gray" />
				<SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="Gray" />
				<SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="Gray" />
			</CheckBox.Resources>
		</CheckBox>
		<DockPanel IsEnabled="{Binding isPrivate}">
			<ScrollViewer DockPanel.Dock="Left" Height="320" Width="200" Margin="5" Background="#151515">
				<StackPanel Margin="2">

					<ItemsControl Items="{Binding users}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Button Command="{Binding $parent[ItemsControl].DataContext.SwitchAllowedUser}" CommandParameter="{Binding name}" Background="Transparent" Width="200" Content="{Binding name}" />
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

				</StackPanel>
			</ScrollViewer>
			<Panel>
				<StackPanel VerticalAlignment="Center" Width="500" Margin="20">
					<Label HorizontalAlignment="Center" FontSize="20" Content="Manage allowed users"/>
					<TextBox Text="{Binding newUserPrivate}" Watermark="User" Margin="5,10,5,5"/>
					<UniformGrid Rows="1" Columns="2">
						<Button Command="{Binding AddUserPrivate}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="5">Add user</Button>
						<Button Command="{Binding DeleteUserPrivate}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="5">Delete user</Button>
					</UniformGrid>
					<Label HorizontalAlignment="Center" Content="{Binding errorPrivate}"/>
				</StackPanel>
			</Panel>
		</DockPanel>
	</StackPanel>

</UserControl>
