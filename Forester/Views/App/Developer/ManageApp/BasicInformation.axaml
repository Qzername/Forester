<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Forester.Views.App.Developer.ManageApp.BasicInformation"
			 xmlns:local="using:Forester.Views.Elements">
	<StackPanel IsEnabled="{Binding isSuperDeveloper}">
		<Label HorizontalAlignment="Center" Margin="0,10" Content="Basic information" FontSize="25"/>

		<Panel Margin="0,0,0,10" Height="200">
			<Image Source="{Binding backgroundPicture}" Stretch="UniformToFill" />
			<Panel Width="70" Height="70">
				<local:ProfilePicture/>
				<Image Source="{Binding profilePicture}" Stretch="UniformToFill" Width="62" Height="62" Margin="2"/>
			</Panel>
		</Panel>

		<UniformGrid IsEnabled="{Binding makeChanges}" Margin="100,0" HorizontalAlignment="Stretch" Rows="1" Columns="2">
			<Button Command="{Binding UploadNewProfilePicture}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="5">Upload new profile picture</Button>
			<Button Command="{Binding UploadNewBackgroundPicture}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="5">Upload new background picture</Button>
		</UniformGrid>

		<TextBox IsEnabled="{Binding makeChanges}" Text="{Binding appName}" Watermark="Name of App" Margin="5" MaxLength="100"/>
		<TextBox IsEnabled="{Binding makeChanges}" Text="{Binding quickDescription}" Watermark="Quick description" Margin="5" MaxLength="100"/>
		<TextBox IsEnabled="{Binding makeChanges}" Text="{Binding description}" Watermark="Description" AcceptsTab="True" TextWrapping="Wrap" AcceptsReturn="True" Margin="5" VerticalContentAlignment="Stretch" MaxLength="2000"/>

		<UniformGrid HorizontalAlignment="Stretch" Rows="1" Columns="2">
			<Button Command="{Binding SwitchChanges}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="5" Content="{Binding switchChangesButtonContent}"/>
			<Button Command="{Binding SubmitChanges}" IsEnabled="{Binding makeChanges}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="5">Submit changes</Button>
		</UniformGrid>

		<Label HorizontalAlignment="Center" Content="{Binding errorSwitchChanges}" FontSize="18" Margin="5,3,0,0"/>
		<Label HorizontalAlignment="Left" Content="{Binding currentVersion}" FontSize="14" Margin="5,3,0,0"/>
	</StackPanel>
</UserControl>
