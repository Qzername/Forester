<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="720"
             x:Class="Forester.Views.App.Library.AppView">
	<DockPanel>
		<Panel DockPanel.Dock="Top" Height="300">
			<Image Stretch="UniformToFill" Source="{Binding backgroundPicture}"/>
			<Label VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="64" Content="{Binding appName}"/>
		</Panel>
		<DockPanel DockPanel.Dock="Top" Height="70" Background="#151515">
			<Button Command="{Binding Run}" DockPanel.Dock="Left" Margin="10,0,0,0" VerticalContentAlignment="Center" Padding="20,10,20,10" Height="50">Run</Button>
			<Button Command="{Binding Download}" DockPanel.Dock="Left" Margin="10,0,0,0" VerticalContentAlignment="Center" Padding="20,10,20,10" Height="50">Download</Button>
			<Button Command="{Binding Delete}" DockPanel.Dock="Left" Margin="10,0,0,0" VerticalContentAlignment="Center" Padding="20,10,20,10" Height="50">Delete</Button>
			<Button Command="{Binding DeleteFromLibrary}" DockPanel.Dock="Left" Margin="10,0,0,0" VerticalContentAlignment="Center" Padding="20,10,20,10" Height="50">Delete from library</Button>
			<DockPanel Margin="10">
				<Label DockPanel.Dock="Top" FontSize="20" HorizontalAlignment="Center" Content="Download:"/>
				<ProgressBar Height="15"/>
			</DockPanel>		
		</DockPanel>
		<ScrollViewer>
			<DockPanel Margin="10">
				<Label DockPanel.Dock="Top" HorizontalAlignment="Center" FontSize="32" Content="Description:"/>
				<Panel Margin="0,10,0,0">
					<TextBlock TextWrapping="Wrap" Text="{Binding description}"/>
				</Panel>
			</DockPanel>
		</ScrollViewer>
	</DockPanel>
	
</UserControl>
