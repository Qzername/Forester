<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Forester.Views.App.Library.AppView"
			 
             xmlns:md="using:Markdown.Avalonia">
	<ScrollViewer>
		<DockPanel>
			<Panel DockPanel.Dock="Top" Height="300">
				<Image Stretch="UniformToFill" Source="{Binding currentElement.BackgroundPicture}"/>
				<Label VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="64" Content="{Binding currentElement.Application.Name}"/>
			</Panel>

			<DockPanel DockPanel.Dock="Top" Height="70" Background="#151515">
				<Button Command="{Binding Run}" FontSize="36" DockPanel.Dock="Right" VerticalAlignment="Center" Height="51" HorizontalContentAlignment="Center" Margin="10" Width="150">Run</Button>
				
				<StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="10,5,0,5">	
					<Button IsEnabled="{Binding !currentElement.DownloadSettings.IsDownloaded}" Width="110" Command="{Binding Download}" DockPanel.Dock="Left"  HorizontalContentAlignment="Center" Padding="20,3,20,3" >Download</Button>
					<Button IsEnabled="{Binding currentElement.DownloadSettings.IsDownloaded}" Width="110" Command="{Binding Update}" DockPanel.Dock="Left" HorizontalContentAlignment="Center" Padding="20,3,20,3" >Update</Button>
				</StackPanel>
			</DockPanel>
			<md:MarkdownScrollViewer Margin="20" Markdown="{Binding currentElement.Application.Description}"/>
		</DockPanel>
	</ScrollViewer>
</UserControl>
