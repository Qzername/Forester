<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Forester.Views.App.Library.AppView">
	<ScrollViewer>
		<DockPanel>
			<Panel DockPanel.Dock="Top" Height="300">
				<Image Stretch="UniformToFill" Source="{Binding backgroundPicture}"/>
				<Label VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="64" Content="{Binding appName}"/>
			</Panel>


			<DockPanel DockPanel.Dock="Top" Height="70" Background="#151515">
				<StackPanel VerticalAlignment="Center" Margin="10,5,0,5">
					<Button IsEnabled="{Binding canDownload}" Width="110" Command="{Binding Download}" DockPanel.Dock="Left"  HorizontalContentAlignment="Center" Padding="20,3,20,3" >Download</Button>
					<Button IsEnabled="{Binding !canDownload}" Width="110" Command="{Binding Update}" DockPanel.Dock="Left" HorizontalContentAlignment="Center" Padding="20,3,20,3" >Update</Button>
				</StackPanel>

				<StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,5,10,5">
					<Button IsEnabled="{Binding !canDownload}" Width="150" Command="{Binding Delete}" Margin="10,0,0,0" HorizontalContentAlignment="Center" Padding="10,3,10,3" >Delete</Button>
					<Button Width="150" Command="{Binding DeleteFromLibrary}" Margin="10,0,0,0" HorizontalContentAlignment="Center" Padding="10,3,10,3">Delete from library</Button>
				</StackPanel>

				<DockPanel DockPanel.Dock="Left"  Margin="10,10,0,10">
					<Label DockPanel.Dock="Top" FontSize="20" HorizontalAlignment="Center" Content="Download:"/>
					<ProgressBar Value="{Binding progress}" Height="15"/>
				</DockPanel>
			</DockPanel>

			<DockPanel Margin="10">
				<Label DockPanel.Dock="Top" HorizontalAlignment="Center" FontSize="32" Content="Description:"/>
				<Panel Margin="0,10,0,0">
					<TextBlock TextWrapping="Wrap" Text="{Binding description}"/>
				</Panel>
			</DockPanel>
		</DockPanel>
	</ScrollViewer>
</UserControl>
