<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Forester.Views.App.Download.AppInQueue"
			 xmlns:local="using:Forester.Views.Elements">
	
	<Panel Height="110" Background="Gray">
		<StackPanel Orientation="Horizontal">
			<local:ProfilePicture Width="110" HorizontalAlignment="Left"/>
			<TextBlock Text="ToolBox" FontSize="55" Padding="15,5,0,0" VerticalAlignment="Center"/>
		</StackPanel>

		<Grid HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20,0" DockPanel.Dock="Right">
			<Grid.ColumnDefinitions>
				<ColumnDefinition/>
				<ColumnDefinition/>
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition/>
				<RowDefinition/>
			</Grid.RowDefinitions>

			<TextBlock Margin="5" Classes="DownloadGridSpeed" Text="Update"/>
			<TextBlock Margin="5,0" Classes="DownloadGridText" Grid.Row="1" Text="Type"/>
			<TextBlock Margin="10,5" Classes="DownloadGridSpeed" Grid.Column="1" Text="100MB"/>
			<TextBlock Margin="10,0" Classes="DownloadGridText" Grid.Column="1" Grid.Row="1" Text="Size"/>
		</Grid>
	</Panel>
</UserControl>
