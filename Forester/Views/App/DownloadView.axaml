<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
             x:Class="Forester.Views.App.DownloadView"
			 xmlns:local="using:Forester.Views.App.Download">
	
	<UserControl.Styles>
		<StyleInclude Source="/Views/Style/Download.axaml" />
	</UserControl.Styles>
	
	<Panel>

		<Panel IsVisible="{Binding IsEmpty}" VerticalAlignment="Center" HorizontalAlignment="Center">
			<TextBlock FontSize="32" Text="Nothing to download"/>
		</Panel>

		<ScrollViewer>
			<StackPanel IsVisible="{Binding !IsEmpty}">

				<!--Debug-->
				<Panel HorizontalAlignment="Center"  Height="70">
					<Button Command="{Binding SampleToQueueAdd}" Content="Add Sample Program"/>	
				</Panel>
				
				<local:CurrentDownloadedApp/>
				<local:AppInQueue/>
			</StackPanel>
		</ScrollViewer>
	</Panel>
</UserControl>
