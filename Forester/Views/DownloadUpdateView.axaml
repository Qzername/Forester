<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Forester.Views.DownloadUpdateView">
	<Panel VerticalAlignment="Center" HorizontalAlignment="Center">
		<StackPanel>
			<TextBlock TextAlignment="Center" Foreground="{Binding third}" FontSize="34" Text="Forester"/>
			<TextBlock TextAlignment="Center" Foreground="{Binding first}" FontSize="22" Text="is currently updating"/>
			<ProgressBar Width="300" Height="5" Margin="0,13,0,0" Value="{Binding progress}"/>
		</StackPanel>
	</Panel>
</UserControl>
