<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Forester.Views.Dialogs.NewVersionInfoView">
	<StackPanel Margin="10" Spacing="10">
		<Label Content="New version is available" HorizontalAlignment="Center" FontSize="32"/>
		<TextBlock HorizontalAlignment="Center" Text="New version is currently downloading. Shortly after downloading, Forester will restart. Please don't close application." TextWrapping="Wrap"/>
		<ProgressBar Margin="0,10,0,0" Value="{Binding value}"/>
	</StackPanel>
</UserControl>
