<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Forester.Views.Dialogs.SettingsDialog.AccountView">
	<ScrollViewer>
		<Panel>
			<TextBlock Foreground="{Binding theme.ThirdBrush}" Text="Account" FontSize="64" HorizontalAlignment="Center"/>
			
			<StackPanel VerticalAlignment="Center" Margin="0,0,7,0">
				<Panel>
					<Image Source="{Binding userDataService.BackgroundPicture}" Height="200" Stretch="UniformToFill"/>
					<Image Source="{Binding userDataService.ProfilePicture}" Width="100" Height="100" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="UniformToFill"/>
				</Panel>

				<TextBlock Text="{Binding userDataService.CurrentAccount.Username}" FontSize="48" HorizontalAlignment="Center"/>
				<TextBlock Text="{Binding Path=userDataService.CurrentAccount.Login, StringFormat='@{0}'}" FontFamily="24" HorizontalAlignment="Center"/>
			</StackPanel>
		</Panel>
		
	</ScrollViewer>
</UserControl>
