<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Forester.Views.Dialogs.SettingsDialog.AccountView">
	<ScrollViewer>
		<StackPanel Spacing="10" Margin="10">
			<TextBlock Foreground="{Binding theme.ThirdBrush}" Text="Account" FontSize="64" HorizontalAlignment="Center"/>
			<Image Source="{Binding userDataService.ProfilePicture}" Width="500" Height="500" Stretch="UniformToFill"/>
		</StackPanel>
	</ScrollViewer>
</UserControl>
