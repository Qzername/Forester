<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Forester.Views.Dialogs.ErrorMessageView">
	<Panel>
		<StackPanel>
			<Label HorizontalAlignment="Center" Content="Something went wrong..." Foreground="Red" FontSize="32"/>
			<TextBlock Text="{Binding friendlyMessage}"/>
			<TextBlock Text="{Binding statusCode}"/>
			<TextBlock Text="{Binding technicalMessage}"/>
		</StackPanel>

		<Button Margin="15" Content="X" Command="{Binding CloseDialog}" VerticalAlignment="Top" HorizontalAlignment="Right"/>
	</Panel>
	
</UserControl>
