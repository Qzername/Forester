<Window x:Class="Forester.DeveloperPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Forester"
        mc:Ignorable="d"
        Title="DeveloperPanel" Height="450" Width="800" Background="#FF323232" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" WindowStyle="None">
    <Grid>
        <Grid x:Name="ToolBar" Margin="0,0,0,0" MouseDown="DragBar_MouseDown" Height="18" Width="auto" VerticalAlignment="Top">
            <Rectangle Fill="Black" Height="18" VerticalAlignment="Center" Grid.ColumnSpan="2"/>
            <Label Content="Forester - Panel Dewelopera" Width="auto" Height="auto" x:Name="Info" Foreground="White" HorizontalAlignment="Left" Margin="-2,-5,0,0" VerticalAlignment="Top"/>

            <Button BorderBrush="Transparent" Margin="781,0,0,0" VerticalAlignment="Center" Height="18" Width="18" Click="Exit_Clicked" HorizontalAlignment="Left" MinWidth="18" MinHeight="18">
                <Button.Background>
                    <ImageBrush ImageSource="/IMG/X.png"/>
                </Button.Background>
            </Button>
        </Grid>
        <ListBox SelectionMode="Single" x:Name="applist" Margin="10,23,0,57" Background="#FF4D4D4D" BorderBrush="#01ABADB3" SelectionChanged="applist_SelectionChanged" Foreground="White" HorizontalAlignment="Left" Width="188" Height="370"/>
        <Button Content="Opublikuj nową aplikacje" HorizontalAlignment="Left" Margin="10,398,0,0" VerticalAlignment="Top" Height="42" Width="188" Click="Button_Click"/>
        <Label Content="Tytuł" HorizontalAlignment="Left" Margin="484,30,0,0" VerticalAlignment="Top" Height="16" Foreground="White" Width="26" Padding="0"/>
        <TextBox x:Name="NameInput" HorizontalAlignment="Left" Margin="203,51,0,0" Text="Wybierz aplikacje" TextWrapping="Wrap" VerticalAlignment="Top" Width="587"/>
        <TextBox AcceptsReturn="True"  x:Name="DescriptionInput" HorizontalAlignment="Left" Margin="203,95,0,0" Text="Wybierz aplikacje" TextWrapping="Wrap" VerticalAlignment="Top" Width="587" Height="153"/>
        <Label Content="Opis&#xD;&#xA;" HorizontalAlignment="Left" Margin="484,74,0,0" VerticalAlignment="Top" Height="16" Foreground="White" Width="26" Padding="0"/>
        <CheckBox x:Name="isprivate" Content="Czy aplikacja ma być prywatna?" HorizontalAlignment="Left" Margin="203,253,0,0" VerticalAlignment="Top" Foreground="White" Unchecked="isprivate_Unchecked" Checked="isprivate_Checked"/>
        <TextBox AcceptsReturn="True" x:Name="AllowedIdsInput" HorizontalAlignment="Left" Margin="203,294,0,0" Text="Wybierz aplikacje" TextWrapping="Wrap" VerticalAlignment="Top" Width="186" Height="145"/>
        <Label Content="Dozwoleni użytkownicy (podaj id)" HorizontalAlignment="Left" Margin="208,273,0,0" VerticalAlignment="Top" Height="16" Foreground="White" Width="177" Padding="0"/>
        <Button x:Name="InfoUpload" Content="Zaaktulizuj dane" HorizontalAlignment="Left" Margin="400,328,0,0" VerticalAlignment="Top" Height="84" Width="193" Click="InfoUpload_Click"/>
        <Button x:Name="VersionUpload" Content="Opublikuj nową wersje" HorizontalAlignment="Left" Margin="598,328,0,0" VerticalAlignment="Top" Height="84" Width="192" Click="VersionUpload_Click"/>
        <TextBox x:Name="VersionInput" HorizontalAlignment="Left" Margin="402,268,0,0" Text="Wybierz aplikacje" TextWrapping="Wrap" VerticalAlignment="Top" Width="388"/>
        <Label Content="Wersja aplikacji" HorizontalAlignment="Left" Margin="556,250,0,0" VerticalAlignment="Top" Height="16" Foreground="White" Width="80" Padding="0"/>
        <Label x:Name="Error" Content="&#xD;&#xA; " HorizontalAlignment="Left" Margin="400,417,0,0" VerticalAlignment="Top" Height="22" Foreground="White" Width="390" Padding="0" HorizontalContentAlignment="Center" FontSize="16"/>
        <Label Content="Ścieżka do aplikacji (folder)" HorizontalAlignment="Left" Margin="524,288,0,0" VerticalAlignment="Top" Height="16" Foreground="White" Width="144" Padding="0"/>
        <TextBox x:Name="DirectoryInput" HorizontalAlignment="Left" Margin="402,304,0,0" Text="Ścieżka" TextWrapping="Wrap" VerticalAlignment="Top" Width="388" Height="19"/>
    </Grid>
</Window>
